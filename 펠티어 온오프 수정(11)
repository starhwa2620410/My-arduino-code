#include <OneWire.h>
#include <DallasTemperature.h>

// 핀 및 제어 신호 설정
#define ONE_WIRE_BUS  2    // DS18B20 DATA 핀 (4.7kΩ 저항 사용)
#define COOLER_MOSFET 7    // 펠티어 MOSFET SIG 핀 (D7)

// MOSFET 모듈 신호 정의 (일반 N-Ch MOSFET 기준 HIGH = ON)
#define PELTIER_ON  LOW   
#define PELTIER_OFF HIGH    

// 목표 온도 설정
const float TARGET_COOL_START_TEMP = 80.0; // 냉각 시작 감지 온도 (80.0°C)
const float TARGET_COOL_TEMP       = 25.0; // 최종 냉각 목표 온도 (25.0°C)
const float COOL_TOLERANCE         = 0.5;  // 25.5°C 이하 도달 시 완료 조건

const float EMERGENCY_MAX_TEMP     = 100.0; // 비상 과열 차단 온도 (100.0°C)
const int REQUIRED_CONSECUTIVE     = 3;     // 연속 도달 인정 횟수 (3회 = 6초간 유지)

OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);

// 실험 상태 정의
enum State {
  WAITING_TO_START, // 시작 대기
  WAITING_FOR_80C,  // 80°C 도달 대기
  COOLING,          // 펠티어 냉각 진행 중
  STOPPED           // 실험 종료
};

State currentState = WAITING_TO_START;

// 데이터 저장 배열 (350개 = 약 11분 40초 저장 가능)
const int MAX_DATA_POINTS = 350; 
uint16_t dataLog[MAX_DATA_POINTS];
int dataCount = 0;

// 제어 및 타이밍 변수
unsigned long startTime = 0;
unsigned long lastLogTime = 0;
const unsigned long LOG_INTERVAL = 2000; // 측정 간격: 2초 (2000ms)

// 연속 감지 검증용 변수
int coolConsecutiveCount = 0;

// 25°C 최초 진입 지점 저장용 변수
int candidateIndex = -1;
float candidateTime = 0.0;
float candidateTemp = 0.0;

int targetReachedIndex = -1;
float targetReachedTime = 0.0;
float targetReachedTemp = 0.0;

// 시리얼 입력 버퍼
char inputCmd[10];
byte cmdIndex = 0;

// 함수 선언
void testPeltier();
void startExperiment();
void stopExperiment(bool isEmergency);
void printResults();

void setup() {
  Serial.begin(9600);
  
  pinMode(COOLER_MOSFET, OUTPUT);
  digitalWrite(COOLER_MOSFET, PELTIER_OFF); // 초기 상태: 펠티어 OFF

  sensors.begin();
  sensors.setResolution(12);

  Serial.println(F("=================================================="));
  Serial.println(F("===      알루미늄 블록 펠티어 냉각 실험 시스템     ==="));
  Serial.println(F("=================================================="));

  // 1. 센서 존재 확인
  int deviceCount = sensors.getDeviceCount();
  if (deviceCount == 0) {
    Serial.println(F("[오류] DS18B20 온도 센서를 찾을 수 없습니다!"));
    Serial.println(F("▶ D2 핀 데이터 연결, VCC/GND 전원, 4.7kΩ 저항 연결을 점검하세요.\n"));
  } else {
    Serial.print(F("[확인] 온도 센서 정상 인식 완료 (감지된 센서: "));
    Serial.print(deviceCount);
    Serial.println(F("개)"));
  }

  // 2. 펠티어 연결 사전 자동 점검 (1초간 신호 출력)
  Serial.println(F("[점검] 펠티어 MOSFET(D7) 신호 자가 진단 중 (1초간 ON)..."));
  digitalWrite(COOLER_MOSFET, PELTIER_ON);
  delay(1000);
  digitalWrite(COOLER_MOSFET, PELTIER_OFF);
  Serial.println(F("▶ MOSFET 모듈의 LED 점등 또는 전원 공급 장치의 전류 반응을 확인하세요.\n"));

  Serial.println(F("▶ 사전 개별 점검: 시리얼 모니터에 'test' 입력 (3초간 가동)"));
  Serial.println(F("▶ 실험 시작: 'start' 입력"));
  Serial.println(F("▶ 실험 중단: 'end' 입력\n"));
}

void loop() {
  // 시리얼 입력 처리 ('start', 'end', 'test')
  while (Serial.available() > 0) {
    char c = (char)Serial.read();
    if (c == '\n' || c == '\r') {
      if (cmdIndex > 0) {
        inputCmd[cmdIndex] = '\0';
        
        if (currentState == WAITING_TO_START && strcasecmp(inputCmd, "test") == 0) {
          cmdIndex = 0;
          testPeltier(); // 사전 개별 점검 실행
          return;
        }
        else if (currentState == WAITING_TO_START && strcasecmp(inputCmd, "start") == 0) {
          cmdIndex = 0;
          startExperiment();
          return;
        } 
        else if ((currentState == WAITING_FOR_80C || currentState == COOLING) && strcasecmp(inputCmd, "end") == 0) {
          cmdIndex = 0;
          stopExperiment(false);
          return;
        }
        cmdIndex = 0;
      }
    } else if (cmdIndex < sizeof(inputCmd) - 1) {
      inputCmd[cmdIndex++] = c;
    }
  }

  if (currentState == WAITING_TO_START || currentState == STOPPED) return;

  unsigned long currentMillis = millis();
  if (currentMillis - lastLogTime >= LOG_INTERVAL) {
    lastLogTime += LOG_INTERVAL;

    float elapsedTime = (currentMillis - startTime) / 1000.0;

    // 실시간 동기식 온도 측정
    sensors.requestTemperatures();
    float currentTemp = sensors.getTempCByIndex(0);

    if (currentTemp == DEVICE_DISCONNECTED_C || currentTemp < -50.0) {
      Serial.println(F("[경고] 센서 연결 오류! 안전을 위해 실험을 중단합니다."));
      stopExperiment(true);
      return;
    }

    if (dataCount < MAX_DATA_POINTS) {
      dataLog[dataCount] = (uint16_t)(currentTemp * 100.0);
      dataCount++;
    }

    // [안전 장치] 비상 과열 차단 (100.0°C)
    if (currentTemp >= EMERGENCY_MAX_TEMP) {
      Serial.println(F("\n[비상 경고] 온도가 과열 한계치(100.0°C)를 초과했습니다!"));
      stopExperiment(true);
      return;
    }

    // 1. 80.0°C 도달 대기 상태
    if (currentState == WAITING_FOR_80C) {
      digitalWrite(COOLER_MOSFET, PELTIER_OFF);

      if (currentTemp >= TARGET_COOL_START_TEMP) {
        currentState = COOLING;
        digitalWrite(COOLER_MOSFET, PELTIER_ON);

        Serial.println(F("\n========================================"));
        Serial.print(F("❄️ [냉각 시작] 80.0°C 도달 감지! (현재 온도: "));
        Serial.print(currentTemp, 2);
        Serial.println(F("°C)"));
        Serial.println(F("펠티어 MOSFET 신호 출력 중... (D7 HIGH)"));
        Serial.println(F("========================================\n"));
      }
    } 
    // 2. 냉각 진행 상태
    else if (currentState == COOLING) {
      digitalWrite(COOLER_MOSFET, PELTIER_ON);

      if (currentTemp <= (TARGET_COOL_TEMP + COOL_TOLERANCE)) {
        if (coolConsecutiveCount == 0) {
          candidateIndex = dataCount - 1;
          candidateTime = elapsedTime;
          candidateTemp = currentTemp;
        }
        coolConsecutiveCount++;

        if (coolConsecutiveCount >= REQUIRED_CONSECUTIVE && targetReachedIndex == -1) {
          targetReachedIndex = candidateIndex;
          targetReachedTime = candidateTime;
          targetReachedTemp = candidateTemp;

          Serial.print(F("\n[목표 달성] 연속 3회 25.5°C 이하 감지 확인!"));
          Serial.print(F(" (최초 진입 시점: "));
          Serial.print(targetReachedTime, 1);
          Serial.print(F("초, 온도: "));
          Serial.print(targetReachedTemp, 2);
          Serial.println(F(" °C)\n"));
        }
      } else {
        coolConsecutiveCount = 0;
        candidateIndex = -1;
      }
    }

    // 실시간 상태 로그
    Serial.print(F("시간: "));
    Serial.print(elapsedTime, 1);
    Serial.print(F("s | 현재 온도: "));
    Serial.print(currentTemp, 2);
    Serial.print(F(" °C | 상태: "));
    if (currentState == WAITING_FOR_80C) {
      Serial.println(F("80°C 도달 대기 중 [D7 OFF]"));
    } else if (currentState == COOLING) {
      Serial.print(F("펠티어 냉각 가동 중 [D7 ON]"));
      if (coolConsecutiveCount > 0) {
        Serial.print(F(" [25°C 도달: "));
        Serial.print(coolConsecutiveCount);
        Serial.print(F("/3]"));
      }
      Serial.println();
    }
  }
}

// 펠티어 사전 수동 점검 함수 ('test' 명령어 입력 시)
void testPeltier() {
  Serial.println(F("\n========================================"));
  Serial.println(F("⚙️ [펠티어 수동 점검] 3초간 펠티어를 가동합니다..."));
  
  sensors.requestTemperatures();
  float startTemp = sensors.getTempCByIndex(0);

  digitalWrite(COOLER_MOSFET, PELTIER_ON); // D7 ON
  
  for (int i = 3; i > 0; i--) {
    Serial.print(F("▶ 가동 중... "));
    Serial.print(i);
    Serial.println(F("초 남음 (MOSFET LED/전원 확인)"));
    delay(1000);
  }

  digitalWrite(COOLER_MOSFET, PELTIER_OFF); // D7 OFF
  
  sensors.requestTemperatures();
  float endTemp = sensors.getTempCByIndex(0);

  Serial.print(F("▶ 점검 전 온도: "));
  Serial.print(startTemp, 2);
  Serial.print(F(" °C | 점검 후 온도: "));
  Serial.print(endTemp, 2);
  Serial.println(F(" °C"));
  Serial.println(F("✔ 점검 완료! 이상이 없다면 'start'를 입력하여 실험을 시작하세요."));
  Serial.println(F("========================================\n"));
}

// 실험 시작 함수
void startExperiment() {
  dataCount = 0;
  coolConsecutiveCount = 0;
  candidateIndex = -1;
  targetReachedIndex = -1;
  targetReachedTime = 0.0;
  targetReachedTemp = 0.0;

  sensors.requestTemperatures();
  float initialTemp = sensors.getTempCByIndex(0);

  startTime = millis();
  lastLogTime = startTime;

  Serial.println(F("\n========================================"));
  Serial.println(F("▶ 'start' 명령 수신: 실험이 시작되었습니다!"));

  if (initialTemp >= TARGET_COOL_START_TEMP) {
    currentState = COOLING;
    digitalWrite(COOLER_MOSFET, PELTIER_ON);
    Serial.print(F("❄️ [즉시 냉각 가동] 현재 온도("));
    Serial.print(initialTemp, 2);
    Serial.println(F("°C)가 80.0°C 이상이므로 펠티어(D7 ON)를 가동합니다."));
  } else {
    currentState = WAITING_FOR_80C;
    digitalWrite(COOLER_MOSFET, PELTIER_OFF);
    Serial.print(F("⏳ [대기 중] 현재 온도("));
    Serial.print(initialTemp, 2);
    Serial.println(F("°C)가 80.0°C 미만입니다. 80.0°C 도달 시 펠티어가 가동됩니다."));
  }
  Serial.println(F("========================================\n"));
}

// 실험 종료 함수
void stopExperiment(bool isEmergency) {
  digitalWrite(COOLER_MOSFET, PELTIER_OFF);
  currentState = STOPPED;

  Serial.println(F("\n========================================"));
  if (isEmergency) {
    Serial.println(F("▶ [비상 중단] 안전 장치 작동으로 실험이 비상 중단되었습니다."));
  } else {
    Serial.println(F("▶ [실험 종료] 사용자의 'end' 명령 수신으로 실험이 종료되었습니다."));
  }
  Serial.println(F("펠티어 MOSFET(D7) 전원 차단 완료."));
  Serial.println(F("========================================\n"));

  printResults();
}

// CSV 출력 함수
void printResults() {
  Serial.println(F("=================================================="));
  Serial.println(F("===                실험 결과 요약               ==="));
  Serial.println(F("=================================================="));
  
  if (targetReachedIndex != -1) {
    Serial.print(F("★ 25.0°C (±0.5°C 범위) 연속 진입 최초 시점: "));
    Serial.print(targetReachedTime, 1);
    Serial.print(F("초 (최초 측정 온도: "));
    Serial.print(targetReachedTemp, 2);
    Serial.println(F(" °C)\n"));
  } else {
    Serial.println(F("※ 목표 냉각 온도(25.5°C 이하) 연속 도달 전 실험이 중단되었습니다.\n"));
  }

  Serial.println(F("=== [CSV DATA START] ==="));
  Serial.println(F("Time(s),Temperature(C),Note"));

  for (int i = 0; i < dataCount; i++) {
    float timeSec = i * (LOG_INTERVAL / 1000.0);
    float temp = dataLog[i] / 100.0;

    Serial.print(timeSec, 1);
    Serial.print(F(","));
    Serial.print(temp, 2);
    Serial.print(F(","));

    if (i == targetReachedIndex) {
      Serial.print(F("25C_Target_Reached"));
    } else {
      Serial.print(F("-"));
    }
    Serial.println();
  }
  Serial.println(F("=== [CSV DATA END] ===\n"));
}
