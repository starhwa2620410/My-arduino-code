#include <OneWire.h>
#include <DallasTemperature.h>

// 핀 및 제어 신호 설정
#define ONE_WIRE_BUS  2    // DS18B20 DATA 핀 (4.7kΩ 저항 사용)
#define COOLER_MOSFET 7    // 펠티어 MOSFET SIG 핀 (D7)
#define BUZZER_PIN    11   // ALP1205S 부저 핀 (D11)

// Active LOW 방식 반영 (LOW = 0V일 때 펠티어 가동)
#define PELTIER_ON  LOW   
#define PELTIER_OFF HIGH  

// 목표 온도 설정 (60°C 도달 시 냉각 시작)
const float TARGET_COOL_START_TEMP = 60.0; // 60°C 도달 시 냉각 시작
const float TARGET_COOL_TEMP       = 25.0; // 25°C 이하 도달 시 냉각 완료
const float EMERGENCY_MAX_TEMP     = 100.0; // 비상 과열 차단 온도 (100.0°C)

OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);

// 실험 상태 정의 - 온도 센서의 측정값에 따라 실험 상태가 바뀔 것임
enum State {
  WAITING_TO_START, // 시작 명령 대기
  WAITING_FOR_60C,  // 60°C 도달 대기
  COOLING,          // 펠티어 냉각 진행 중
  COMPLETED,        // 25°C 도달 (냉각 완료)
  STOPPED           // 사용자/비상 중단
};

State currentState = WAITING_TO_START;

// 제어 및 타이밍 변수
unsigned long startTime = 0;
unsigned long lastLogTime = 0;
const unsigned long LOG_INTERVAL = 2000; // 측정 간격: 2초 (2000ms)

// 부저 제어 변수 (울림 시간 1초)
bool isBuzzerActive = false;
unsigned long buzzerStartTime = 0;
const unsigned long BUZZER_DURATION = 1000; // 60°C 도달 시 부저 울림 시간: 1초 (1000ms)

// 시리얼 입력 버퍼
char inputCmd[10];
byte cmdIndex = 0;

// 함수 선언 - 부저 울리기 / 부저 테스트 / 아두이노 테스트 / 실험 시작 / 실험 중단, 총 5개
void triggerBuzzer();
void testBuzzerDiagnostic();
void testPeltier();
void startExperiment();
void stopExperiment(bool isEmergency);

void setup() {
  Serial.begin(9600);
  
  pinMode(COOLER_MOSFET, OUTPUT);
  digitalWrite(COOLER_MOSFET, PELTIER_OFF); // 초기 상태: 펠티어 OFF

  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);           // 초기 상태: 부저 OFF

  sensors.begin();
  sensors.setResolution(12);

  Serial.println(F("=================================================="));
  Serial.println(F("===      알루미늄 블록 펠티어 냉각 실험 시스템     ==="));
  Serial.println(F("=================================================="));

  // 1. 온도 센서 연결 상태 확인
  int deviceCount = sensors.getDeviceCount();
  if (deviceCount == 0) {
    Serial.println(F("[오류] DS18B20 온도 센서를 찾을 수 없습니다!"));
    Serial.println(F("▶ D2 핀 데이터 연결, VCC/GND 전원, 4.7kΩ 저항 연결을 점검하세요.\n"));
  } else {
    Serial.print(F("[확인] 온도 센서 정상 인식 완료 (감지된 센서: "));
    Serial.print(deviceCount);
    Serial.println(F("개)"));
  }

  // 2. 부저 연결 자가 진단 (부팅 시 짧게 0.1초 신호)
  testBuzzerDiagnostic();

  // 3. 펠티어 MOSFET(D7) 신호 출력 점검 (1초간 가동)
  Serial.println(F("[점검] 펠티어 MOSFET(D7) 신호 출력 점검 중 (1초)..."));
  digitalWrite(COOLER_MOSFET, PELTIER_ON);
  delay(1000);
  digitalWrite(COOLER_MOSFET, PELTIER_OFF);
  Serial.println(F("▶ MOSFET LED 및 팬 가동을 확인하세요.\n"));

  Serial.println(F("▶ 사전 펠티어 단독 점검: 시리얼 모니터에 'test' 입력"));
  Serial.println(F("▶ 실험 시작: 'start' 입력"));
  Serial.println(F("▶ 실험 중단: 'end' 입력\n"));
}

void loop() {
  // 부저 1초 울림 후 타이머 차단 제어
  if (isBuzzerActive && (millis() - buzzerStartTime >= BUZZER_DURATION)) {
    noTone(BUZZER_PIN);
    digitalWrite(BUZZER_PIN, LOW);
    isBuzzerActive = false;
  }

  // 시리얼 모니터(실험 중 텍스트로 명령 내릴 수 있는 곳) 입력 처리 ('start', 'end', 'test')
  while (Serial.available() > 0) {
    char c = (char)Serial.read();
    if (c == '\n' || c == '\r') {
      if (cmdIndex > 0) {
        inputCmd[cmdIndex] = '\0';
        
        if (currentState == WAITING_TO_START && strcasecmp(inputCmd, "test") == 0) {
          cmdIndex = 0;
          testPeltier();   // 시리얼 모니터에 'test' 입력 시 펠티어 소자 테스트(실험 시작 전)
          return;
        }
        else if (currentState == WAITING_TO_START && strcasecmp(inputCmd, "start") == 0) {
          cmdIndex = 0;
          startExperiment();   // 시리얼 모니터에 'start' 입력 시 실험 시작
          return;
        } 
        else if ((currentState == WAITING_FOR_60C || currentState == COOLING) && strcasecmp(inputCmd, "end") == 0) {
          cmdIndex = 0;
          stopExperiment(false);  // 실험 시작 후 모니터에 'end' 입력 시 실험 종료
          return;
        }
        cmdIndex = 0;
      }
    } else if (cmdIndex < sizeof(inputCmd) - 1) {
      inputCmd[cmdIndex++] = c;
    }
  }

  if (currentState == WAITING_TO_START || currentState == STOPPED || currentState == COMPLETED) return;

  unsigned long currentMillis = millis();
  if (currentMillis - lastLogTime >= LOG_INTERVAL) {
    lastLogTime += LOG_INTERVAL;

    float elapsedTime = (currentMillis - startTime) / 1000.0;

    // 실시간 온도 측정
    sensors.requestTemperatures();
    float currentTemp = sensors.getTempCByIndex(0);  // 온도 센서의 측정값을 currentTemp로 받음(펠티어 작동 등의 기준이 됨)

    if (currentTemp == DEVICE_DISCONNECTED_C || currentTemp < -50.0) {
      Serial.println(F("[경고] 센서 연결 오류! 안전을 위해 실험을 중단합니다."));
      stopExperiment(true);
      return;
    }

    // [안전 장치] 비상 과열 차단 (100.0°C)
    if (currentTemp >= EMERGENCY_MAX_TEMP) {
      Serial.println(F("\n[비상 경고] 온도가 과열 한계치(100.0°C)를 초과했습니다!"));
      stopExperiment(true);
      return;
    }

    // 1. 60.0°C 도달 대기 중
    if (currentState == WAITING_FOR_60C) {
      digitalWrite(COOLER_MOSFET, PELTIER_OFF);

      if (currentTemp >= TARGET_COOL_START_TEMP) { 
        currentState = COOLING;    // 현재 온도가 냉각 시작 온도(60도) 도달 시 냉각 시작
        digitalWrite(COOLER_MOSFET, PELTIER_ON);
        triggerBuzzer(); // 60°C 최초 도달 시 1초간 부저 작동
      }
    } 
    // 2. 냉각 진행 과정 (60°C -> 25°C)
    else if (currentState == COOLING) {
      digitalWrite(COOLER_MOSFET, PELTIER_ON);  // 펠티어 가동 시작

      if (currentTemp <= TARGET_COOL_TEMP) {   // 현재 온도가 목표 냉각 온도(25도) 이하 도달 시 실험 종료
        Serial.print((long)elapsedTime);
        Serial.print(F(" ; "));
        Serial.print(currentTemp, 2);
        Serial.println(F(" ; 냉각 완료"));

        digitalWrite(COOLER_MOSFET, PELTIER_OFF);
        noTone(BUZZER_PIN);
        digitalWrite(BUZZER_PIN, LOW);
        currentState = COMPLETED;

        Serial.println(F("\n========================================"));
        Serial.println(F("🎉 [실험 완료] 목표 온도(25.0°C 이하)에 도달하여 냉각을 종료합니다."));
        Serial.println(F("펠티어 전원 차단 완료."));
        Serial.println(F("========================================\n"));
        return;
      }
    }

    // 실시간 상태 출력 포맷: "시간 ; 온도 ; 상태" (단위 없음)
    Serial.print((long)elapsedTime);
    Serial.print(F(" ; "));
    Serial.print(currentTemp, 2);
    Serial.print(F(" ; "));

    if (currentState == WAITING_FOR_60C) {
      Serial.println(F("60°C 대기 중"));
    } else if (currentState == COOLING) {
      Serial.println(F("펠티어 가동 중"));
    }
  }
}

// 🔔 1초 부저 가동 트리거 함수
void triggerBuzzer() {
  tone(BUZZER_PIN, 2500);
  digitalWrite(BUZZER_PIN, HIGH);
  isBuzzerActive = true;
  buzzerStartTime = millis();
}

// 🔊 부저 초기 점검 함수 (부팅 시 0.1초만 짧게 출력)
void testBuzzerDiagnostic() {
  Serial.println(F("[점검] D11 부저 연결 점검 중 (짧은 알림음)..."));
  
  tone(BUZZER_PIN, 2500, 100);
  digitalWrite(BUZZER_PIN, HIGH);
  delay(100);
  noTone(BUZZER_PIN);
  digitalWrite(BUZZER_PIN, LOW);
}

// 수동 펠티어 점검 함수 ('test' 입력 시 - 부저 울림 완전히 제외)
void testPeltier() {
  Serial.println(F("\n========================================"));
  Serial.println(F("⚙️ [수동 점검] 부저 없이 3초간 펠티어만 가동합니다..."));
  
  sensors.requestTemperatures();
  float startTemp = sensors.getTempCByIndex(0);

  digitalWrite(COOLER_MOSFET, PELTIER_ON); // 펠티어만 ON (부저 작동 안 함)
  
  for (int i = 3; i > 0; i--) {
    Serial.print(F("▶ 가동 중... "));
    Serial.print(i);
    Serial.println(F("초 남음"));
    delay(1000);
  }

  digitalWrite(COOLER_MOSFET, PELTIER_OFF);
  
  sensors.requestTemperatures();
  float endTemp = sensors.getTempCByIndex(0);

  Serial.print(F("▶ 점검 전 온도: "));
  Serial.print(startTemp, 2);
  Serial.print(F(" | 점검 후 온도: "));
  Serial.println(endTemp, 2);
  Serial.println(F("✔ 점검 완료! 이상이 없다면 'start'를 입력하여 실험을 시작하세요."));
  Serial.println(F("========================================\n"));
}

// 실험 시작 함수
void startExperiment() {
  sensors.requestTemperatures();
  float initialTemp = sensors.getTempCByIndex(0);

  startTime = millis();
  lastLogTime = startTime;

  Serial.println(F("\n========================================"));
  Serial.println(F("▶ 'start' 명령 수신: 실험이 시작되었습니다!"));

  if (initialTemp >= TARGET_COOL_START_TEMP) {
    currentState = COOLING;
    digitalWrite(COOLER_MOSFET, PELTIER_ON);
    triggerBuzzer(); // 60°C 이상 시작 시 1초 부저
  } else {
    currentState = WAITING_FOR_60C;
    digitalWrite(COOLER_MOSFET, PELTIER_OFF);
  }
  Serial.println(F("========================================\n"));
}

// 실험 중단 함수
void stopExperiment(bool isEmergency) {
  digitalWrite(COOLER_MOSFET, PELTIER_OFF);
  noTone(BUZZER_PIN);
  digitalWrite(BUZZER_PIN, LOW);
  isBuzzerActive = false;
  currentState = STOPPED;

  Serial.println(F("\n========================================"));
  if (isEmergency) {
    Serial.println(F("▶ [비상 중단] 안전 장치 작동으로 실험이 비상 중단되었습니다."));
  } else {
    Serial.println(F("▶ [실험 중단] 사용자의 'end' 명령 수신으로 실험이 중단되었습니다."));
  }
  Serial.println(F("펠티어 전원 및 부저 차단 완료."));
  Serial.println(F("========================================\n"));
}
